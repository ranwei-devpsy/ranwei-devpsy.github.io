---
import '../styles/global.css';
import profile from '../data/profile.json';
import { pathFor } from '../lib/paths';
import { content } from '../lib/content';
const { title, active = 'home' } = Astro.props as { title: string; active?: string };
const c = content;
const description = c.description;
const navigation = [
  { key: 'home', label: c.nav.home, url: '' },
  { key: 'about', label: c.nav.about, url: 'about/' },
  { key: 'research', label: c.nav.research, url: 'research/' },
  { key: 'publications', label: c.nav.publications, url: 'publications/' },
  { key: 'teaching', label: c.nav.teaching, url: 'teaching/' },
];
const route = navigation.find(item => item.key === active)?.url || '';
const absolute = (url: string) => Astro.site ? new URL(url, Astro.site).href : url;
const updated = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${profile.updatedISO}T00:00:00Z`));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8c1d2c" />
    <meta property="og:title" content={`${title} | ${c.name} · ${c.university}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {Astro.site && <link rel="canonical" href={absolute(pathFor(route))} />}
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <title>{title} | {c.name} · {c.university}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">{c.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={pathFor()} aria-label={c.homeLabel}>{c.name}<span>{c.university}</span></a>
        <div class="header-tools">
          <nav class="main-nav" aria-label={c.mainNavigation}>
            {navigation.map(item => <a href={pathFor(item.url)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </div>
      </div>
    </header>
    <main id="main" class="site-main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div><strong>{c.name}</strong><span>{c.school} · {c.university}</span></div>
        <div class="footer-right"><div>{profile.email}</div><span>{c.updated} {updated}</span></div>
      </div>
    </footer>
  </body>
</html>
